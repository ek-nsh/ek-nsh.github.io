---
import { nav, isCurrent } from '../data/nav';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const links = nav.map((l) => ({ ...l, current: isCurrent(l.match, path) }));
---

<!-- Every [data-hdr] item decides for itself whether the black hole's dark has reached it. -->
<header class="site-header" data-header>
  <a class="logo" href={`${base}/`} aria-label="Home" data-hdr>
    e<span class="logo-dot" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle class="ring-bg" cx="12" cy="12" r="10"></circle><circle class="ring-fg" data-progress cx="12" cy="12" r="10" pathLength="1"></circle></svg>
    </span>k
  </a>

  <nav class="nav" aria-label="Primary">
    {links.map((l) => <a href={l.href} data-hdr aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
  </nav>

  <div class="header-actions">
    <button class="pill" type="button" data-tour-start data-magnetic data-hdr aria-label="Start the guided recruiter tour">
      <span class="dot" aria-hidden="true"></span>
      Recruiter mode
    </button>
    <button class="pill menu-btn" type="button" data-menu-toggle data-hdr aria-expanded="false" aria-controls="mobile-menu">
      Menu
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu>
  {links.map((l) => <a href={l.href} data-menu-link aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
</div>
