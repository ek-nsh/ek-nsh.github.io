---
import { formatDate, type PostItem } from '../lib/posts';

interface Props {
  posts: PostItem[];
  /** Mark the first row as the recruiter-tour target. */
  tourFirst?: boolean;
  /** Narrow layout for half-width columns: date, title and meta stack. */
  compact?: boolean;
}

const { posts, tourFirst = false, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ol class:list={['post-list', { compact }]}>
  {posts.map(({ entry, minutes, peek }, i) => (
    <li>
      <a class="post-row" href={`${base}/writing/${entry.id}`} data-cursor-label="Read" data-tour={tourFirst && i === 0 ? 'writing' : undefined}>
        <span class="mono date"><canvas class="glyph" width="5" height="5" data-glyph={entry.id} aria-hidden="true"></canvas>{formatDate(entry.data.date)}</span>
        <span class="body">
          <span class="title">{entry.data.title}</span>
          <span class="desc">{entry.data.description}</span>
        </span>
        <span class="meta mono">{entry.data.tags.join(' · ')} · {minutes} min</span>
        <span class="arrow" aria-hidden="true">→</span>
        {compact && peek && (
          <span class="peek" aria-hidden="true"><i class="mono">1</i><span>{peek}</span></span>
        )}
      </a>
    </li>
  ))}
</ol>

<style>
  .post-list { border-top: 1px solid var(--line); }
  .post-list li { border-bottom: 1px solid var(--line); }
  .post-row {
    display: grid; grid-template-columns: 120px 1fr auto 28px; gap: 12px 28px; align-items: start;
    padding: clamp(22px, 3vw, 34px) clamp(10px, 1.6vw, 22px);
    position: relative; isolation: isolate;
  }
  .post-row::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--wash);
    opacity: 0; transition: opacity 0.4s var(--ease);
  }
  .post-row:hover::before { opacity: 1; }
  .date { padding-top: 9px; }
  .body { display: grid; gap: 8px; }
  .title { font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; }
  .desc { color: var(--ink-2); max-width: 56ch; }
  .meta { padding-top: 10px; text-align: right; }
  .arrow { font-size: 20px; padding-top: 4px; transition: transform 0.4s var(--ease), color 0.4s var(--ease); }
  .post-row:hover .arrow { transform: translateX(5px); color: var(--ember); }

  .compact .post-row { grid-template-columns: 1fr 24px; gap: 8px 16px; padding-inline: 0; }
  .compact .date { grid-column: 1 / -1; padding-top: 0; }
  .compact .title { font-size: clamp(20px, 1.9vw, 26px); }
  .compact .meta { grid-column: 1 / -1; text-align: left; padding-top: 0; }
  .compact .arrow { grid-row: 2; grid-column: 2; }
  .compact .post-row::before { inset-inline: -14px; border-radius: 12px; }

  /* A glimpse of the post's first margin note, which slides open on hover. */
  .glyph { width: 20px; height: 20px; margin-right: 10px; vertical-align: -5px; image-rendering: pixelated; }
  .peek {
    grid-column: 1 / -1; display: grid; grid-template-columns: 16px 1fr; gap: 8px; align-items: start;
    max-height: 0; overflow: hidden; opacity: 0; transform: translateY(-4px);
    font-size: 13.5px; line-height: 1.45; color: var(--ink-2);
    transition: max-height 0.55s var(--ease), opacity 0.4s var(--ease), transform 0.5s var(--ease);
  }
  .peek i { font-style: normal; color: var(--ember); }
  .peek::before { content: none; }
  .post-row:hover .peek, .post-row:focus-visible .peek { max-height: 90px; opacity: 1; transform: none; }
  @media (hover: none) { .peek { max-height: none; opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .post-row { grid-template-columns: 1fr 24px; }
    .date { grid-column: 1 / -1; padding-top: 0; }
    .meta { grid-column: 1 / -1; text-align: left; padding-top: 0; }
    .arrow { grid-row: 2; grid-column: 2; }
  }
</style>
