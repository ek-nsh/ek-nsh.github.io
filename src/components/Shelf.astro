---
import type { ShelfItem } from '../data/profile';

interface Props {
  items: ShelfItem[];
  /** The tall version used on the Lab page. */
  tall?: boolean;
}

const { items, tall = false } = Astro.props;

// Spines vary in height, width and colour so the shelf looks lived in, not generated.
const heights = [168, 192, 178, 204, 172, 188, 160, 196, 182];
const widths = [22, 30, 26, 34, 24, 28, 32, 22, 26];
const tones: [string, string][] = [
  ['#1b1a18', '#fbfaf7'], ['#e8532f', '#fbfaf7'], ['#b9b7b2', '#1b1a18'], ['#f2a03d', '#1b1a18'], ['#5e5c57', '#fbfaf7'],
  ['#e7e4dd', '#1b1a18'], ['#1b1a18', '#fbfaf7'], ['#e8532f', '#fbfaf7'], ['#9a978f', '#1b1a18'],
];
const scale = tall ? 1.55 : 1;
---

<div class:list={['shelf', { tall }]} data-shelf>
  <ul class="spines">
    {items.map((b, i) => (
      <li
        class:list={['spine', { 'is-empty': b.empty }]}
        tabindex={b.href ? undefined : 0}
        data-title={b.title || 'An empty slot'}
        data-take={b.take}
        style={`--h:${Math.round(heights[i % heights.length] * scale)}px;--w:${Math.round(widths[i % widths.length] * (tall ? 1.3 : 1))}px;--bg:${tones[i % tones.length][0]};--fg:${tones[i % tones.length][1]}`}
      >
        {b.href ? (
          <a class="spine-link" href={b.href} target="_blank" rel="noopener" aria-label={`${b.title} (opens in a new tab)`}><span>{b.title}</span></a>
        ) : (
          <span>{b.title}</span>
        )}
      </li>
    ))}
  </ul>
  <div class="plank"></div>
</div>
