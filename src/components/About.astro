---
import { profile } from '../data/profile';

/** Split into words at build time so each can slide up from a mask. */
const words = (s: string) => s.split(' ');
---

<section class="section" id="about">
  <div class="wrap rail-grid">
    <p class="rail" data-reveal><span class="mono idx">01</span><span class="mono">About</span></p>

    <div class="rail-body about-body">
      {profile.about.map((p, i) => (
        <p class:list={['para', { second: i > 0 }]} data-words>
          {words(p).map((w) => <span class="w"><span>{w}</span></span>).flatMap((el, idx, arr) => (idx < arr.length - 1 ? [el, ' '] : [el]))}
        </p>
      ))}

      <div class="interests" data-reveal>
        <span class="mono">Interests</span>
        <ul>
          {profile.interests.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-body { display: grid; gap: clamp(20px, 3vw, 36px); }

  .para {
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1.22;
    letter-spacing: -0.03em;
    font-weight: 400;
    max-width: 24em;
  }
  .para.second { color: var(--ink-3); }

  .interests { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 8px; }
  .interests ul { display: flex; flex-wrap: wrap; gap: 8px; }
  .interests li {
    padding: 7px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--card);
    font-size: 14px; color: var(--ink-2);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .interests li:hover { border-color: var(--ember); color: var(--ember); }
</style>
